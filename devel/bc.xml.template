<?xml version="1.0" encoding="utf-8"?>
<interface xmlns="http://zero-install.sourceforge.net/2004/injector/interface">
  <name>Bc</name>
  <summary>arbitrary precision calculator language</summary>
  <description>bc is an arbitrary precision numeric processing language with a syntax similar to C, supporting interactive execution of statements. This package also contains dc, a reverse-polish desk calculator.</description>
  <homepage>https://www.gnu.org/software/bc/</homepage>
  <icon href="https://apps.0install.net/utils/gnu.png" type="image/png"/>
  <icon href="https://apps.0install.net/utils/gnu.ico" type="image/vnd.microsoft.icon"/>
  <category>Development</category>
  <needs-terminal/>

  <feed-for interface="https://apps.0install.net/devel/bc.xml"/>

  <group license="GPL-3.0-or-later">
    <requires interface="https://apps.0install.net/lib/readline8.xml">
      <environment insert="bin" name="PATH"/>
    </requires>
    <command name="run" path="bin/bc.exe"/>
    <command name="dc" path="bin/dc.exe"/>
    <implementation arch="Windows-x86_64" released="{released}" stability="stable" version="{version}">
      <manifest-digest/>
      <archive extract="ucrt64" href="https://repo.msys2.org/mingw/ucrt64/mingw-w64-ucrt-x86_64-bc-{pkgver}-{pkgrel}-any.pkg.tar.zst" type="application/x-zstd-compressed-tar"/>
    </implementation>
    <implementation arch="Windows-aarch64" released="{released}" stability="stable" version="{version}">
      <manifest-digest/>
      <archive extract="clangarm64" href="https://repo.msys2.org/mingw/clangarm64/mingw-w64-clang-aarch64-bc-{pkgver}-{pkgrel}-any.pkg.tar.zst" type="application/x-zstd-compressed-tar"/>
    </implementation>
  </group>
</interface>
