<?xml version="1.0" encoding="utf-8"?>
<interface xmlns="http://zero-install.sourceforge.net/2004/injector/interface">
  <name>GitHub Copilot CLI</name>
  <summary>GitHub Copilot coding agent in your terminal</summary>
  <description>GitHub Copilot CLI brings the power of Copilot coding agent directly to your terminal. It works alongside you to research, plan, and build.</description>
  <homepage>https://github.com/github/copilot-cli</homepage>
  <category>Development</category>
  <icon href="https://apps.0install.net/devel/github.png" type="image/png"/>
  <needs-terminal/>

  <feed-for interface="https://apps.0install.net/devel/github-copilot-cli.xml"/>

  <group license="Proprietary">
    <command name="run" path="copilot"/>
    <implementation arch="Linux-x86_64" version="{version}" released="{released}" stability="stable">
      <manifest-digest/>
      <archive href="https://github.com/github/copilot-cli/releases/download/v{version}/copilot-linux-x64.tar.gz" type="application/x-compressed-tar"/>
    </implementation>
    <implementation arch="Linux-aarch64" version="{version}" released="{released}" stability="stable">
      <manifest-digest/>
      <archive href="https://github.com/github/copilot-cli/releases/download/v{version}/copilot-linux-arm64.tar.gz" type="application/x-compressed-tar"/>
    </implementation>
    <implementation arch="Darwin-x86_64" version="{version}" released="{released}" stability="stable">
      <manifest-digest/>
      <archive href="https://github.com/github/copilot-cli/releases/download/v{version}/copilot-darwin-x64.tar.gz" type="application/x-compressed-tar"/>
    </implementation>
    <implementation arch="Darwin-aarch64" version="{version}" released="{released}" stability="stable">
      <manifest-digest/>
      <archive href="https://github.com/github/copilot-cli/releases/download/v{version}/copilot-darwin-arm64.tar.gz" type="application/x-compressed-tar"/>
    </implementation>
  </group>

  <group license="Proprietary">
    <command name="run" path="copilot.exe"/>
    <implementation arch="Windows-x86_64" version="{version}" released="{released}" stability="stable">
      <manifest-digest/>
      <archive href="https://github.com/github/copilot-cli/releases/download/v{version}/copilot-win32-x64.zip" type="application/zip"/>
    </implementation>
    <implementation arch="Windows-aarch64" version="{version}" released="{released}" stability="stable">
      <manifest-digest/>
      <archive href="https://github.com/github/copilot-cli/releases/download/v{version}/copilot-win32-arm64.zip" type="application/zip"/>
    </implementation>
  </group>
</interface>
