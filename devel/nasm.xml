<?xml version="1.0" ?>
<interface xmlns="http://zero-install.sourceforge.net/2004/injector/interface" uri="https://apps.0install.net/devel/nasm.xml">
  <name>NASM</name>
  <summary>the Netwide Assembler for x86</summary>
  <description>NASM, the Netwide Assembler, is an assembler and disassembler for the Intel x86 architecture. It can output several binary formats, including COFF, OMF, a.out, ELF, Mach-O and binary. This package also contains ndisasm, a disassembler.</description>
  <homepage>https://www.nasm.us/</homepage>
  <category>Development</category>
  <needs-terminal/>

  <package-implementation distributions="Debian RPM Arch" package="nasm">
    <command name="run" path="/usr/bin/nasm"/>
    <command name="ndisasm" path="/usr/bin/ndisasm"/>
  </package-implementation>
  <package-implementation distributions="Gentoo" package="dev-lang/nasm">
    <command name="run" path="/usr/bin/nasm"/>
    <command name="ndisasm" path="/usr/bin/ndisasm"/>
  </package-implementation>
  <package-implementation distributions="MacPorts" package="nasm">
    <command name="run" path="/opt/local/bin/nasm"/>
    <command name="ndisasm" path="/opt/local/bin/ndisasm"/>
  </package-implementation>

  <entry-point binary-name="nasm" command="run">
    <needs-terminal/>
    <name>NASM</name>
    <summary>assemble x86 code</summary>
  </entry-point>
  <entry-point command="ndisasm">
    <needs-terminal/>
    <name>ndisasm</name>
    <summary>disassemble x86 code</summary>
  </entry-point>

  <group license="BSD-2-Clause">
    <requires interface="https://apps.0install.net/lib/zlib.xml">
      <environment insert="bin" name="PATH"/>
    </requires>
    <command name="run" path="bin/nasm.exe"/>
    <command name="ndisasm" path="bin/ndisasm.exe"/>
