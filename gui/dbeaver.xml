<?xml version="1.0" ?>
<?xml-stylesheet type='text/xsl' href='../resources/feed.xsl'?>
<interface xmlns="http://zero-install.sourceforge.net/2004/injector/interface" uri="https://apps.0install.net/gui/dbeaver.xml">
  <script xmlns="http://www.w3.org/1999/xhtml" src="../resources/xslt-polyfill.min.js"/>
  <name>DBeaver</name>
  <summary>universal database tool and SQL client</summary>
  <description>DBeaver is a free, universal database tool for developers, database administrators, analysts, and everyone working with data. It supports MySQL, PostgreSQL, SQLite, Oracle, DB2, SQL Server, Sybase, MS Access, Teradata, Firebird, Apache Hive, Phoenix, Presto, and many other databases via JDBC.</description>
  <icon href="https://apps.0install.net/gui/dbeaver.png" type="image/png"/>
  <icon href="https://apps.0install.net/gui/dbeaver.ico" type="image/vnd.microsoft.icon"/>
  <icon href="https://apps.0install.net/gui/dbeaver.icns" type="image/x-icns"/>
  <category>Development</category>
  <homepage>https://dbeaver.io/</homepage>

  <feed arch="Linux-*" src="https://apps.0install.net/gui/dbeaver-linux.xml"/>
  <feed arch="MacOSX-*" src="https://apps.0install.net/gui/dbeaver-macos.xml"/>
  <feed arch="Windows-*" src="https://apps.0install.net/gui/dbeaver-windows.xml"/>

  <entry-point binary-name="dbeaver" command="run"/>
</interface>
