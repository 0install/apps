    <package-implementation distributions="Debian" main="/usr/bin/javac" package="openjdk-20-jdk"/>
    <package-implementation distributions="Debian" main="/usr/bin/javac" package="openjdk-21-jdk"/>
    <package-implementation distributions="Debian" main="/usr/bin/javac" package="openjdk-22-jdk"/>
    <package-implementation distributions="Debian" main="/usr/bin/javac" package="openjdk-23-jdk"/>
