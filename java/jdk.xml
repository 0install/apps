    <package-implementation distributions="Debian" main="/usr/bin/javac" package="openjdk-26-jdk"/>
    <package-implementation distributions="Debian" main="/usr/bin/javac" package="openjdk-27-jdk"/>

    <package-implementation distributions="RPM" main="/usr/bin/javac" package="java-1_7_0-openjdk-devel"/>
    <package-implementation distributions="RPM" main="/usr/bin/javac" package="java-1.7.0-openjdk-devel"/>
    <package-implementation distributions="RPM" main="/usr/bin/javac" package="java-1_8_0-openjdk-devel"/>
