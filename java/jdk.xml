<?xml version="1.0" ?>
<?xml-stylesheet type='text/xsl' href='../resources/feed.xsl'?>
<interface xmlns="http://zero-install.sourceforge.net/2004/injector/interface" uri="https://apps.0install.net/java/jdk.xml">
  <name>Java Development Kit (JDK)</name>
  <summary>SDK for Java</summary>
  <description>Development environment for building applications, applets, and components using the Java programming language.</description>
  <category>Development</category>
  <icon href="https://apps.0install.net/java/java.png" type="image/png"/>

  <feed src="https://apps.0install.net/java/openjdk.xml"/>
  <feed arch="Windows-*" src="https://apps.0install.net/java/microsoft-jdk.xml"/>
  <feed arch="Linux-*" src="https://apps.0install.net/java/temurin-jdk.xml"/>
  <feed arch="MacOSX-*" src="https://apps.0install.net/java/temurin-jdk.xml"/>

  <package-implementation distributions="Darwin Windows" package="openjdk-7-jdk"/>
  <package-implementation distributions="Darwin Windows" package="openjdk-8-jdk"/>
  <package-implementation distributions="Windows" package="openjdk-9-jdk"/>
  <package-implementation distributions="Windows" package="openjdk-10-jdk"/>
  <package-implementation distributions="Windows" package="openjdk-11-jdk"/>
