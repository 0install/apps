<?xml version="1.0" ?>
<?xml-stylesheet type='text/xsl' href='../resources/feed.xsl'?>
<interface xmlns="http://zero-install.sourceforge.net/2004/injector/interface" uri="https://apps.0install.net/java/jre.xml">
  <name>Java Runtime Environment (JRE)</name>
  <summary>Runtime for Java</summary>
  <description>A Java runtime allows you to run applications built for Java.</description>
  <icon href="https://apps.0install.net/java/java.png" type="image/png"/>

  <feed src="https://apps.0install.net/java/oraclejre-8.xml"/>

  <!-- Modern Java versions don't offer JRE-only redistributables, so use full JDK instead. JRE-only native packages still exist though (see below). -->
  <feed src="https://apps.0install.net/java/openjdk.xml"/>
  <feed arch="Windows-*" src="https://apps.0install.net/java/microsoft-jdk.xml"/>
  <feed arch="Linux-*" src="https://apps.0install.net/java/temurin-jdk.xml"/>
  <feed arch="MacOSX-*" src="https://apps.0install.net/java/temurin-jdk.xml"/>

  <package-implementation distributions="Windows" package="openjdk-7-jre"/>
  <package-implementation distributions="Windows" package="openjdk-8-jre"/>
  <package-implementation distributions="Windows" package="openjdk-9-jre"/>
  <package-implementation distributions="Windows" package="openjdk-10-jre"/>

  <group>
    <!-- There is a separate GUI version of the Java executable on Windows. On POSIX systems we simply map it back to regular Java. -->
    <command name="run-gui">
      <runner interface="https://apps.0install.net/java/jre.xml"/>
    </command>

    <package-implementation distributions="Debian Darwin" main="/usr/bin/java" package="openjdk-7-jre"/>
    <package-implementation distributions="Debian Darwin" main="/usr/bin/java" package="openjdk-8-jre"/>
    <package-implementation distributions="Debian" main="/usr/bin/java" package="openjdk-9-jre"/>
    <package-implementation distributions="Debian" main="/usr/bin/java" package="openjdk-10-jre"/>
    <package-implementation distributions="Debian" main="/usr/bin/java" package="openjdk-11-jre"/>
    <package-implementation distributions="Debian" main="/usr/bin/java" package="openjdk-12-jre"/>
    <package-implementation distributions="Debian" main="/usr/bin/java" package="openjdk-13-jre"/>
    <package-implementation distributions="Debian" main="/usr/bin/java" package="openjdk-14-jre"/>
    <package-implementation distributions="Debian" main="/usr/bin/java" package="openjdk-15-jre"/>
    <package-implementation distributions="Debian" main="/usr/bin/java" package="openjdk-16-jre"/>
    <package-implementation distributions="Debian" main="/usr/bin/java" package="openjdk-17-jre"/>
    <package-implementation distributions="Debian" main="/usr/bin/java" package="openjdk-18-jre"/>
    <package-implementation distributions="Debian" main="/usr/bin/java" package="openjdk-19-jre"/>
    <package-implementation distributions="Debian" main="/usr/bin/java" package="openjdk-20-jre"/>
    <package-implementation distributions="Debian" main="/usr/bin/java" package="openjdk-21-jre"/>
    <package-implementation distributions="Debian" main="/usr/bin/java" package="openjdk-22-jre"/>
    <package-implementation distributions="Debian" main="/usr/bin/java" package="openjdk-23-jre"/>
    <package-implementation distributions="Debian" main="/usr/bin/java" package="openjdk-24-jre"/>
    <package-implementation distributions="Debian" main="/usr/bin/java" package="openjdk-25-jre"/>
    <package-implementation distributions="Debian" main="/usr/bin/java" package="openjdk-26-jre"/>
    <package-implementation distributions="Debian" main="/usr/bin/java" package="openjdk-27-jre"/>

    <package-implementation distributions="RPM" main="/usr/bin/java" package="java-1_7_0-openjdk"/>
    <package-implementation distributions="RPM" main="/usr/bin/java" package="java-1.7.0-openjdk"/>
    <package-implementation distributions="RPM" main="/usr/bin/java" package="java-1_8_0-openjdk"/>
    <package-implementation distributions="RPM" main="/usr/bin/java" package="java-1.8.0-openjdk"/>
    <package-implementation distributions="RPM" main="/usr/bin/java" package="java-9-openjdk"/>
    <package-implementation distributions="RPM" main="/usr/bin/java" package="java-10-openjdk"/>
    <package-implementation distributions="RPM" main="/usr/bin/java" package="java-11-openjdk"/>
    <package-implementation distributions="RPM" main="/usr/bin/java" package="java-12-openjdk"/>
    <package-implementation distributions="RPM" main="/usr/bin/java" package="java-13-openjdk"/>
    <package-implementation distributions="RPM" main="/usr/bin/java" package="java-14-openjdk"/>
    <package-implementation distributions="RPM" main="/usr/bin/java" package="java-15-openjdk"/>
    <package-implementation distributions="RPM" main="/usr/bin/java" package="java-16-openjdk"/>
    <package-implementation distributions="RPM" main="/usr/bin/java" package="java-17-openjdk"/>
    <package-implementation distributions="RPM" main="/usr/bin/java" package="java-18-openjdk"/>
    <package-implementation distributions="RPM" main="/usr/bin/java" package="java-19-openjdk"/>
    <package-implementation distributions="RPM" main="/usr/bin/java" package="java-20-openjdk"/>
    <package-implementation distributions="RPM" main="/usr/bin/java" package="java-21-openjdk"/>
    <package-implementation distributions="RPM" main="/usr/bin/java" package="java-22-openjdk"/>
    <package-implementation distributions="RPM" main="/usr/bin/java" package="java-23-openjdk"/>
    <package-implementation distributions="RPM" main="/usr/bin/java" package="java-24-openjdk"/>
    <package-implementation distributions="RPM" main="/usr/bin/java" package="java-25-openjdk"/>
    <package-implementation distributions="RPM" main="/usr/bin/java" package="java-26-openjdk"/>
    <package-implementation distributions="RPM" main="/usr/bin/java" package="java-27-openjdk"/>
    <package-implementation distributions="RPM" main="/usr/bin/java" package="java-openjdk"/>
    <package-implementation distributions="RPM" main="/usr/bin/java" package="java-latest-openjdk"/>

    <package-implementation distributions="Arch" main="/usr/bin/java" package="jre7-openjdk"/>
    <package-implementation distributions="Arch" main="/usr/bin/java" package="jre8-openjdk"/>
    <package-implementation distributions="Arch" main="/usr/bin/java" package="jre10-openjdk"/>
    <package-implementation distributions="Arch" main="/usr/bin/java" package="jre11-openjdk"/>
    <package-implementation distributions="Arch" main="/usr/bin/java" package="jre17-openjdk"/>
    <package-implementation distributions="Arch" main="/usr/bin/java" package="jre21-openjdk"/>
    <package-implementation distributions="Arch" main="/usr/bin/java" package="jre25-openjdk"/>
    <package-implementation distributions="Arch" main="/usr/bin/java" package="jre-openjdk"/>
  </group>

  <entry-point binary-name="java" command="run">
    <needs-terminal/>
    <name>Java command-line runner</name>
  </entry-point>
  <entry-point binary-name="javaw" command="run-gui">
    <name>Java GUI runner</name>
  </entry-point>
  <entry-point command="javaws">
    <name>Java Web Start</name>
  </entry-point>
  <entry-point command="javacpl">
    <name>Java Control Panel</name>
  </entry-point>
  <entry-point binary-name="keytool" command="keytool">
    <needs-terminal/>
    <name>Key and Certificate Management Tool</name>
  </entry-point>
  <entry-point binary-name="servertool" command="servertool">
    <needs-terminal/>
    <name>Java IDL Server Tool</name>
  </entry-point>
  <entry-point binary-name="pack200" command="pack200">
    <needs-terminal/>
    <name>JAR Packing tool</name>
  </entry-point>
  <entry-point binary-name="unpack200" command="unpack200">
    <needs-terminal/>
    <name>JAR Unpacking tool</name>
  </entry-point>
  <entry-point binary-name="appletviewer" command="appletviewer">
    <name>Run applet outside of browser</name>
  </entry-point>
  <entry-point binary-name="rmid" command="rmid">
    <needs-terminal/>
    <name>Remote activation system daemon</name>
  </entry-point>
  <entry-point binary-name="rmiregistry" command="rmiregistry">
    <needs-terminal/>
    <name>Remote object registry</name>
  </entry-point>
  <entry-point binary-name="idlj" command="idlj">
    <needs-terminal/>
    <name>IDL-to-Java Compiler</name>
  </entry-point>
  <entry-point binary-name="jjs" command="jjs">
    <needs-terminal/>
    <name>Nashorn engine</name>
  </entry-point>
  <entry-point binary-name="jrunscript" command="jrunscript">
    <needs-terminal/>
    <name>Java command line script shell</name>
  </entry-point>
  <entry-point binary-name="kinit" command="kinit">
    <needs-terminal/>
    <name>Obtain and cache Kerberos ticket-granting ticket</name>
  </entry-point>
  <entry-point binary-name="klist" command="klist">
    <needs-terminal/>
    <name>Kerberos display entries in credentials cache and keytab</name>
  </entry-point>
  <entry-point binary-name="ktab" command="ktab">
    <needs-terminal/>
    <name>Kerberos key table manager</name>
  </entry-point>
  <entry-point binary-name="jabswitch" command="jabswitch">
    <needs-terminal/>
    <name>Java Access Bridge Switch</name>
  </entry-point>
  <entry-point binary-name="jaccessinspector" command="jaccessinspector"/>
  <entry-point binary-name="jaccesswalker" command="jaccesswalker"/>

  <capabilities xmlns="http://0install.de/schema/desktop-integration/capabilities">
    <file-type id="jarfile">
      <description>Executable Jar File</description>
      <verb args="-jar &quot;%V&quot; %*" command="run-gui" name="open"/>
      <extension mime-type="application/java-archive" value=".jar"/>
    </file-type>
    <file-type id="JNLPFile">
      <description>JNLP File</description>
      <verb args="&quot;%V&quot;" command="javaws" name="Open">
        <description>&amp;Launch</description>
      </verb>
      <extension mime-type="application/x-java-jnlp-file" value=".jnlp"/>
    </file-type>
  </capabilities>
</interface>
