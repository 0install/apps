<?xml version="1.0" encoding="utf-8"?>
<interface xmlns="http://zero-install.sourceforge.net/2004/injector/interface">
  <name>gcc-libs</name>
  <summary>GNU Compiler Collection (libraries) for MinGW-w64</summary>
  <description>Runtime libraries shipped by GCC: libgcc, libstdc++, libatomic, libgomp (OpenMP) and libquadmath. Required at runtime by many programs built with MinGW-w64 GCC. Windows builds by MSYS2.</description>
  <homepage>https://gcc.gnu.org/</homepage>
  <icon href="https://apps.0install.net/utils/gnu.ico" type="image/vnd.microsoft.icon"/>
  <icon href="https://apps.0install.net/utils/gnu.png" type="image/png"/>
  <category>Development</category>

  <feed-for interface="https://apps.0install.net/lib/gcc-libs.xml"/>

  <group license="GPL-3.0-or-later WITH GCC-exception-3.1 AND LGPL-2.1-or-later">
    <requires interface="https://apps.0install.net/lib/libwinpthread.xml">
      <environment insert="bin" name="PATH"/>
    </requires>
    <implementation arch="Windows-x86_64" released="{released}" stability="stable" version="{version}">
      <manifest-digest/>
      <recipe>
        <archive extract="ucrt64" href="https://repo.msys2.org/mingw/ucrt64/mingw-w64-ucrt-x86_64-libgcc-{pkgver}-{pkgrel}-any.pkg.tar.zst" type="application/x-zstd-compressed-tar"/>
        <archive extract="ucrt64" href="https://repo.msys2.org/mingw/ucrt64/mingw-w64-ucrt-x86_64-libstdc++-{pkgver}-{pkgrel}-any.pkg.tar.zst" type="application/x-zstd-compressed-tar"/>
        <archive extract="ucrt64" href="https://repo.msys2.org/mingw/ucrt64/mingw-w64-ucrt-x86_64-libatomic-{pkgver}-{pkgrel}-any.pkg.tar.zst" type="application/x-zstd-compressed-tar"/>
        <archive extract="ucrt64" href="https://repo.msys2.org/mingw/ucrt64/mingw-w64-ucrt-x86_64-libgomp-{pkgver}-{pkgrel}-any.pkg.tar.zst" type="application/x-zstd-compressed-tar"/>
        <archive extract="ucrt64" href="https://repo.msys2.org/mingw/ucrt64/mingw-w64-ucrt-x86_64-libquadmath-{pkgver}-{pkgrel}-any.pkg.tar.zst" type="application/x-zstd-compressed-tar"/>
      </recipe>
    </implementation>
  </group>
</interface>
