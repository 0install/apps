<?xml version="1.0" encoding="utf-8"?>
<interface xmlns="http://zero-install.sourceforge.net/2004/injector/interface">
  <name>gmp</name>
  <summary>A free library for arbitrary precision arithmetic (mingw-w64)</summary>
  <description>GMP is a free library for arbitrary precision arithmetic, operating on signed integers, rational numbers, and floating-point numbers.</description>
  <homepage>https://gmplib.org/</homepage>
  <icon href="https://apps.0install.net/lib/gmp.png" type="image/png"/>
  <icon href="https://apps.0install.net/lib/gmp.ico" type="image/vnd.microsoft.icon"/>

  <feed-for interface="https://apps.0install.net/lib/gmp.xml"/>

  <group license="LGPL-3.0-or-later OR GPL-2.0-or-later">
    <implementation arch="Windows-x86_64" released="{released}" stability="stable" version="{version}">
      <manifest-digest/>
      <archive extract="ucrt64" href="https://repo.msys2.org/mingw/ucrt64/mingw-w64-ucrt-x86_64-gmp-{pkgver}-{pkgrel}-any.pkg.tar.zst" type="application/x-zstd-compressed-tar"/>
    </implementation>
    <implementation arch="Windows-aarch64" released="{released}" stability="stable" version="{version}">
      <manifest-digest/>
      <archive extract="clangarm64" href="https://repo.msys2.org/mingw/clangarm64/mingw-w64-clang-aarch64-gmp-{pkgver}-{pkgrel}-any.pkg.tar.zst" type="application/x-zstd-compressed-tar"/>
    </implementation>
  </group>
</interface>
