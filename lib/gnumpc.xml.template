<?xml version="1.0" encoding="utf-8"?>
<interface xmlns="http://zero-install.sourceforge.net/2004/injector/interface">
  <name>mpc</name>
  <summary>Multiple precision complex arithmetic library (mingw-w64)</summary>
  <description>GNU MPC is a C library for the arithmetic of complex numbers with arbitrarily high precision and correct rounding of the result. Windows builds by MSYS2.</description>
  <homepage>https://www.multiprecision.org/</homepage>
  <icon href="https://apps.0install.net/utils/gnu.png" type="image/png"/>
  <icon href="https://apps.0install.net/utils/gnu.ico" type="image/vnd.microsoft.icon"/>

  <feed-for interface="https://apps.0install.net/lib/gnumpc.xml"/>

  <group license="LGPL-3.0-or-later">
    <requires interface="https://apps.0install.net/lib/gmp.xml">
      <environment insert="bin" name="PATH"/>
    </requires>
    <requires interface="https://apps.0install.net/lib/mpfr4.xml">
      <environment insert="bin" name="PATH"/>
    </requires>
    <implementation arch="Windows-x86_64" released="{released}" stability="stable" version="{version}">
      <manifest-digest/>
      <archive extract="ucrt64" href="https://repo.msys2.org/mingw/ucrt64/mingw-w64-ucrt-x86_64-mpc-{pkgver}-{pkgrel}-any.pkg.tar.zst" type="application/x-zstd-compressed-tar"/>
    </implementation>
    <implementation arch="Windows-aarch64" released="{released}" stability="stable" version="{version}">
      <manifest-digest/>
      <archive extract="clangarm64" href="https://repo.msys2.org/mingw/clangarm64/mingw-w64-clang-aarch64-mpc-{pkgver}-{pkgrel}-any.pkg.tar.zst" type="application/x-zstd-compressed-tar"/>
    </implementation>
  </group>
</interface>
