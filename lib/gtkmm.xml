<interface xmlns="http://zero-install.sourceforge.net/2004/injector/interface" uri="https://apps.0install.net/lib/gtkmm.xml">
  <script xmlns="http://www.w3.org/1999/xhtml" src="../resources/xslt-polyfill.min.js"/>
  <name>libgtkmm</name>
  <summary>C++ wrappers for GTK+ (shared libraries)</summary>
  <description>Gtkmm is a C++ interface for the popular GUI library GTK+.
Gtkmm provides a convenient interface for C++ programmers to create
graphical user interfaces with GTK+'s flexible OO framework. Highlights
include type safe callbacks, widgets extensible using inheritance and
over 180 classes that can be freely combined to quickly create complex
user interfaces.

This package contains shared libraries.</description>
  <package-implementation package="libgtkmm-2.4-1c2a"/>
  <group>
    <requires interface="https://apps.0install.net/lib/gcc1.xml">
      <environment insert="usr/lib" name="LD_LIBRARY_PATH"/>
    </requires>
    <requires interface="https://apps.0install.net/lib/png12-0.xml">
      <environment insert="usr/lib" name="LD_LIBRARY_PATH"/>
    </requires>
    <requires interface="https://apps.0install.net/lib/stdc++6.xml">
      <environment insert="usr/lib" name="LD_LIBRARY_PATH"/>
    </requires>
    <!--
    <requires interface="https://apps.0install.net/lib/zlib1g.xml">
