<interface xmlns="http://zero-install.sourceforge.net/2004/injector/interface" uri="https://apps.0install.net/lib/libjpeg-turbo-linux.xml">
  <name>libjpeg-turbo - Linux builds</name>
  <summary>JPEG image codec and command-line tools</summary>
  <description>libjpeg-turbo is a JPEG image codec that uses SIMD instructions to accelerate baseline JPEG compression and decompression. This package also provides its command-line tools: jpegtran for lossless transformations of JPEG files (rotation, flipping, cropping, optimization and conversion between baseline and progressive encoding), cjpeg and djpeg for compressing and decompressing JPEG files, and rdjpgcom and wrjpgcom for reading and writing JPEG comments.</description>
  <homepage>https://libjpeg-turbo.org/</homepage>
  <category>Graphics</category>
  <needs-terminal/>

  <feed-for interface="https://apps.0install.net/lib/libjpeg-turbo.xml"/>

