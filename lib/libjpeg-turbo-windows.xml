  <name>libjpeg-turbo - Windows builds</name>
  <summary>JPEG image codec and command-line tools</summary>
  <description>libjpeg-turbo is a JPEG image codec that uses SIMD instructions to accelerate baseline JPEG compression and decompression. This package also provides its command-line tools: jpegtran for lossless transformations of JPEG files (rotation, flipping, cropping, optimization and conversion between baseline and progressive encoding), cjpeg and djpeg for compressing and decompressing JPEG files, and rdjpgcom and wrjpgcom for reading and writing JPEG comments. Built by MSYS2.</description>
  <homepage>https://libjpeg-turbo.org/</homepage>
  <category>Graphics</category>
  <needs-terminal/>

  <feed-for interface="https://apps.0install.net/lib/libjpeg-turbo.xml"/>

  <group license="IJG AND BSD-3-Clause AND Zlib">
    <command name="run" path="bin/jpegtran.exe"/>
    <command name="cjpeg" path="bin/cjpeg.exe"/>
    <command name="djpeg" path="bin/djpeg.exe"/>
    <command name="rdjpgcom" path="bin/rdjpgcom.exe"/>
    <command name="wrjpgcom" path="bin/wrjpgcom.exe"/>
