<?xml version="1.0" encoding="utf-8"?>
<interface xmlns="http://zero-install.sourceforge.net/2004/injector/interface">
  <name>libsystre</name>
  <summary>POSIX regex.h wrapper around TRE</summary>
  <description>libsystre provides the POSIX regcomp/regexec API (regex.h) for Windows, implemented on top of the TRE regular expression library.</description>
  <homepage>https://github.com/msys2/MINGW-packages/tree/master/mingw-w64-libsystre</homepage>
  <category>Development</category>

  <feed-for interface="https://apps.0install.net/lib/libsystre.xml"/>

  <group license="BSD-3-Clause">
    <requires interface="https://apps.0install.net/lib/libtre.xml">
      <environment insert="bin" name="PATH"/>
    </requires>
    <implementation arch="Windows-x86_64" released="{released}" stability="stable" version="{version}">
      <manifest-digest/>
      <archive extract="ucrt64" href="https://repo.msys2.org/mingw/ucrt64/mingw-w64-ucrt-x86_64-libsystre-{pkgver}-{pkgrel}-any.pkg.tar.zst" type="application/x-zstd-compressed-tar"/>
    </implementation>
    <implementation arch="Windows-aarch64" released="{released}" stability="stable" version="{version}">
      <manifest-digest/>
      <archive extract="clangarm64" href="https://repo.msys2.org/mingw/clangarm64/mingw-w64-clang-aarch64-libsystre-{pkgver}-{pkgrel}-any.pkg.tar.zst" type="application/x-zstd-compressed-tar"/>
    </implementation>
  </group>
</interface>
