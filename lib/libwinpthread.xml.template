<?xml version="1.0" encoding="utf-8"?>
<interface xmlns="http://zero-install.sourceforge.net/2004/injector/interface">
  <name>libwinpthread</name>
  <summary>MinGW-w64 winpthreads library</summary>
  <description>POSIX threads (pthreads) implementation for Windows from the MinGW-w64 project. Required at runtime by many programs built with MinGW-w64. Windows builds by MSYS2.</description>
  <homepage>https://www.mingw-w64.org/</homepage>

  <feed-for interface="https://apps.0install.net/lib/libwinpthread.xml"/>

  <group license="MIT AND BSD-3-Clause">
    <implementation arch="Windows-x86_64" released="{released}" stability="stable" version="{version}">
      <manifest-digest/>
      <archive extract="ucrt64" href="https://repo.msys2.org/mingw/ucrt64/mingw-w64-ucrt-x86_64-libwinpthread-{pkgver}-{pkgrel}-any.pkg.tar.zst" type="application/x-zstd-compressed-tar"/>
    </implementation>
    <implementation arch="Windows-aarch64" released="{released}" stability="stable" version="{version}">
      <manifest-digest/>
      <archive extract="clangarm64" href="https://repo.msys2.org/mingw/clangarm64/mingw-w64-clang-aarch64-libwinpthread-{pkgver}-{pkgrel}-any.pkg.tar.zst" type="application/x-zstd-compressed-tar"/>
    </implementation>
  </group>
</interface>
