<?xml version="1.0" encoding="utf-8"?>
<interface xmlns="http://zero-install.sourceforge.net/2004/injector/interface">
  <name>mpfr</name>
  <summary>Multiple-precision floating-point library (mingw-w64)</summary>
  <description>MPFR is a C library for multiple-precision floating-point computations with correct rounding.</description>
  <homepage>https://www.mpfr.org/</homepage>
  <icon href="https://apps.0install.net/lib/mpfr.png" type="image/png"/>
  <icon href="https://apps.0install.net/lib/mpfr.ico" type="image/vnd.microsoft.icon"/>

  <feed-for interface="https://apps.0install.net/lib/mpfr4.xml"/>

  <group license="LGPL-3.0-or-later">
    <requires interface="https://apps.0install.net/lib/gcc-libs.xml">
      <environment insert="bin" name="PATH"/>
    </requires>
    <requires interface="https://apps.0install.net/lib/gmp.xml">
      <environment insert="bin" name="PATH"/>
    </requires>
    <implementation arch="Windows-x86_64" released="{released}" stability="stable" version="{version}">
      <manifest-digest/>
      <archive extract="ucrt64" href="https://repo.msys2.org/mingw/ucrt64/mingw-w64-ucrt-x86_64-mpfr-{pkgver}-{pkgrel}-any.pkg.tar.zst" type="application/x-zstd-compressed-tar"/>
    </implementation>
  </group>

  <group license="LGPL-3.0-or-later">
    <requires interface="https://apps.0install.net/lib/gmp.xml">
      <environment insert="bin" name="PATH"/>
    </requires>
    <implementation arch="Windows-aarch64" released="{released}" stability="stable" version="{version}">
      <manifest-digest/>
      <archive extract="clangarm64" href="https://repo.msys2.org/mingw/clangarm64/mingw-w64-clang-aarch64-mpfr-{pkgver}-{pkgrel}-any.pkg.tar.zst" type="application/x-zstd-compressed-tar"/>
    </implementation>
  </group>
</interface>
