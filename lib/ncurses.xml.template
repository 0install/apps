<?xml version="1.0" encoding="utf-8"?>
<interface xmlns="http://zero-install.sourceforge.net/2004/injector/interface">
  <name>ncurses</name>
  <summary>terminal-independent text-based user interface library</summary>
  <description>The ncurses (new curses) library is a free software emulation of curses in System V Release 4.0 (SVr4), and more. It uses terminfo format, supports pads and color and multiple highlights and forms characters and function-key mapping.</description>
  <homepage>https://invisible-island.net/ncurses/</homepage>
  <icon href="https://apps.0install.net/utils/gnu.png" type="image/png"/>
  <icon href="https://apps.0install.net/utils/gnu.ico" type="image/vnd.microsoft.icon"/>
  <category>Development</category>
  <needs-terminal/>

  <feed-for interface="https://apps.0install.net/lib/ncurses.xml"/>

  <group license="MIT">
    <requires interface="https://apps.0install.net/lib/cc-libs.xml">
      <environment insert="bin" name="PATH"/>
    </requires>
    <requires interface="https://apps.0install.net/lib/pcre2.xml">
      <environment insert="bin" name="PATH"/>
    </requires>
    <requires interface="https://apps.0install.net/lib/libwinpthread.xml">
      <environment insert="bin" name="PATH"/>
    </requires>
    <implementation arch="Windows-x86_64" released="{released}" stability="stable" version="{version}">
      <manifest-digest/>
      <archive extract="ucrt64" href="https://repo.msys2.org/mingw/ucrt64/mingw-w64-ucrt-x86_64-ncurses-{pkgver}-{pkgrel}-any.pkg.tar.zst" type="application/x-zstd-compressed-tar"/>
    </implementation>
    <implementation arch="Windows-aarch64" released="{released}" stability="stable" version="{version}">
      <manifest-digest/>
      <archive extract="clangarm64" href="https://repo.msys2.org/mingw/clangarm64/mingw-w64-clang-aarch64-ncurses-{pkgver}-{pkgrel}-any.pkg.tar.zst" type="application/x-zstd-compressed-tar"/>
    </implementation>
  </group>
</interface>
