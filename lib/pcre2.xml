<?xml version="1.0" ?>
<interface xmlns="http://zero-install.sourceforge.net/2004/injector/interface" uri="https://apps.0install.net/lib/pcre2.xml">
  <name>PCRE2</name>
  <summary>Perl-compatible regular expression library</summary>
  <description>PCRE2 is a library of functions that implement regular expression pattern matching using the same syntax and semantics as Perl 5. This package also contains pcre2grep, a grep with Perl-compatible regular expressions, and pcre2test for testing patterns.</description>
  <homepage>https://pcre2project.github.io/pcre2/</homepage>
  <category>Development</category>
  <needs-terminal/>

  <package-implementation distributions="Debian" package="pcre2-utils">
    <command name="run" path="/usr/bin/pcre2grep"/>
    <command name="pcre2test" path="/usr/bin/pcre2test"/>
  </package-implementation>
  <package-implementation distributions="RPM" package="pcre2-tools">
    <command name="run" path="/usr/bin/pcre2grep"/>
    <command name="pcre2test" path="/usr/bin/pcre2test"/>
  </package-implementation>
  <package-implementation distributions="Arch" package="pcre2">
    <command name="run" path="/usr/bin/pcre2grep"/>
    <command name="pcre2test" path="/usr/bin/pcre2test"/>
  </package-implementation>
  <package-implementation distributions="Gentoo" package="dev-libs/libpcre2">
    <command name="run" path="/usr/bin/pcre2grep"/>
    <command name="pcre2test" path="/usr/bin/pcre2test"/>
  </package-implementation>
  <package-implementation distributions="MacPorts" package="pcre2">
    <command name="run" path="/opt/local/bin/pcre2grep"/>
    <command name="pcre2test" path="/opt/local/bin/pcre2test"/>
  </package-implementation>

  <entry-point binary-name="pcre2grep" command="run">
    <needs-terminal/>
    <name>pcre2grep</name>
    <summary>search files for lines matching a Perl-compatible regular expression</summary>
  </entry-point>
  <entry-point command="pcre2test">
    <needs-terminal/>
    <name>pcre2test</name>
    <summary>test Perl-compatible regular expressions</summary>
  </entry-point>

  <group license="BSD-3-Clause WITH PCRE2-exception">
    <requires interface="https://apps.0install.net/utils/bzip2.xml">
      <environment insert="bin" name="PATH"/>
    </requires>
    <requires interface="https://apps.0install.net/lib/zlib.xml">
      <environment insert="bin" name="PATH"/>
    </requires>
    <requires interface="https://apps.0install.net/lib/wineditline.xml">
      <environment insert="bin" name="PATH"/>
    </requires>
    <command name="run" path="bin/pcre2grep.exe"/>
    <command name="pcre2test" path="bin/pcre2test.exe"/>
