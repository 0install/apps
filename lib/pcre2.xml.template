<?xml version="1.0" encoding="utf-8"?>
<interface xmlns="http://zero-install.sourceforge.net/2004/injector/interface">
  <name>PCRE2</name>
  <summary>Perl-compatible regular expression library</summary>
  <description>PCRE2 is a library of functions that implement regular expression pattern matching using the same syntax and semantics as Perl 5. This package also contains pcre2grep, a grep with Perl-compatible regular expressions, and pcre2test for testing patterns.</description>
  <homepage>https://pcre2project.github.io/pcre2/</homepage>
  <category>Development</category>
  <needs-terminal/>

  <feed-for interface="https://apps.0install.net/lib/pcre2.xml"/>

  <group license="BSD-3-Clause WITH PCRE2-exception">
    <requires interface="https://apps.0install.net/utils/bzip2.xml">
      <environment insert="bin" name="PATH"/>
    </requires>
    <requires interface="https://apps.0install.net/lib/zlib.xml">
      <environment insert="bin" name="PATH"/>
    </requires>
    <requires interface="https://apps.0install.net/lib/wineditline.xml">
      <environment insert="bin" name="PATH"/>
    </requires>
    <command name="run" path="bin/pcre2grep.exe"/>
    <command name="pcre2test" path="bin/pcre2test.exe"/>
    <implementation arch="Windows-x86_64" released="{released}" stability="stable" version="{version}">
      <manifest-digest/>
      <archive extract="ucrt64" href="https://repo.msys2.org/mingw/ucrt64/mingw-w64-ucrt-x86_64-pcre2-{pkgver}-{pkgrel}-any.pkg.tar.zst" type="application/x-zstd-compressed-tar"/>
    </implementation>
    <implementation arch="Windows-aarch64" released="{released}" stability="stable" version="{version}">
      <manifest-digest/>
      <archive extract="clangarm64" href="https://repo.msys2.org/mingw/clangarm64/mingw-w64-clang-aarch64-pcre2-{pkgver}-{pkgrel}-any.pkg.tar.zst" type="application/x-zstd-compressed-tar"/>
    </implementation>
  </group>
</interface>
