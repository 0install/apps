<?xml version="1.0" encoding="utf-8"?>
<interface xmlns="http://zero-install.sourceforge.net/2004/injector/interface">
  <name>Readline</name>
  <summary>GNU readline and history libraries</summary>
  <description>The GNU Readline library provides a set of functions for use by applications that allow users to edit command lines as they are typed in, and to recall previously entered lines.</description>
  <homepage>https://tiswww.case.edu/php/chet/readline/rltop.html</homepage>
  <icon href="https://apps.0install.net/utils/gnu.png" type="image/png"/>
  <icon href="https://apps.0install.net/utils/gnu.ico" type="image/vnd.microsoft.icon"/>
  <category>Development</category>

  <feed-for interface="https://apps.0install.net/lib/readline8.xml"/>

  <group license="GPL-3.0-or-later">
    <requires interface="https://apps.0install.net/lib/termcap.xml">
      <environment insert="bin" name="PATH"/>
    </requires>
    <implementation arch="Windows-x86_64" released="{released}" stability="stable" version="{version}">
      <manifest-digest/>
      <archive extract="ucrt64" href="https://repo.msys2.org/mingw/ucrt64/mingw-w64-ucrt-x86_64-readline-{pkgver}-{pkgrel}-any.pkg.tar.zst" type="application/x-zstd-compressed-tar"/>
    </implementation>
    <implementation arch="Windows-aarch64" released="{released}" stability="stable" version="{version}">
      <manifest-digest/>
      <archive extract="clangarm64" href="https://repo.msys2.org/mingw/clangarm64/mingw-w64-clang-aarch64-readline-{pkgver}-{pkgrel}-any.pkg.tar.zst" type="application/x-zstd-compressed-tar"/>
    </implementation>
  </group>
</interface>
