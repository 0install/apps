<?xml version="1.0" encoding="utf-8"?>
<interface xmlns="http://zero-install.sourceforge.net/2004/injector/interface">
  <name>libxml2</name>
  <summary>GNOME XML library</summary>
  <description>Libxml2 is the XML C parser and toolkit developed for the GNOME project. This package also contains xmllint for checking and formatting XML files and xmlcatalog for managing XML catalogs.</description>
  <homepage>https://gitlab.gnome.org/GNOME/libxml2</homepage>
  <icon href="https://apps.0install.net/lib/xml2.png" type="image/png"/>
  <icon href="https://apps.0install.net/lib/xml2.ico" type="image/vnd.microsoft.icon"/>
  <category>Development</category>
  <needs-terminal/>

  <feed-for interface="https://apps.0install.net/lib/xml2.xml"/>

  <group license="MIT">
    <requires interface="https://apps.0install.net/lib/libiconv.xml">
      <environment insert="bin" name="PATH"/>
    </requires>
    <requires interface="https://apps.0install.net/lib/zlib.xml">
      <environment insert="bin" name="PATH"/>
    </requires>
    <command name="xmllint" path="bin/xmllint.exe"/>
    <command name="xmlcatalog" path="bin/xmlcatalog.exe"/>
    <implementation arch="Windows-x86_64" released="{released}" stability="stable" version="{version}">
      <manifest-digest/>
      <archive extract="ucrt64" href="https://repo.msys2.org/mingw/ucrt64/mingw-w64-ucrt-x86_64-libxml2-{pkgver}-{pkgrel}-any.pkg.tar.zst" type="application/x-zstd-compressed-tar"/>
    </implementation>
    <implementation arch="Windows-aarch64" released="{released}" stability="stable" version="{version}">
      <manifest-digest/>
      <archive extract="clangarm64" href="https://repo.msys2.org/mingw/clangarm64/mingw-w64-clang-aarch64-libxml2-{pkgver}-{pkgrel}-any.pkg.tar.zst" type="application/x-zstd-compressed-tar"/>
    </implementation>
  </group>
</interface>
