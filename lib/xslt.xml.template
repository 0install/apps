<?xml version="1.0" encoding="utf-8"?>
<interface xmlns="http://zero-install.sourceforge.net/2004/injector/interface">
  <name>LibXslt</name>
  <summary>library and tools for applying XSLT to XML documents</summary>
  <description>Libxslt is the XSLT C library developed for the GNOME project. This package also contains xsltproc, a command-line tool for applying XSLT stylesheets to XML documents.</description>
  <homepage>https://gitlab.gnome.org/GNOME/libxslt</homepage>
  <icon href="https://apps.0install.net/lib/xml2.png" type="image/png"/>
  <icon href="https://apps.0install.net/lib/xml2.ico" type="image/vnd.microsoft.icon"/>
  <category>Development</category>
  <needs-terminal/>

  <feed-for interface="https://apps.0install.net/lib/xslt.xml"/>

  <group license="MIT">
    <requires interface="https://apps.0install.net/lib/xml2.xml">
      <environment insert="bin" name="PATH"/>
    </requires>
    <command name="run" path="bin/xsltproc.exe"/>
    <implementation arch="Windows-x86_64" released="{released}" stability="stable" version="{version}">
      <manifest-digest/>
      <archive extract="ucrt64" href="https://repo.msys2.org/mingw/ucrt64/mingw-w64-ucrt-x86_64-libxslt-{pkgver}-{pkgrel}-any.pkg.tar.zst" type="application/x-zstd-compressed-tar"/>
    </implementation>
    <implementation arch="Windows-aarch64" released="{released}" stability="stable" version="{version}">
      <manifest-digest/>
      <archive extract="clangarm64" href="https://repo.msys2.org/mingw/clangarm64/mingw-w64-clang-aarch64-libxslt-{pkgver}-{pkgrel}-any.pkg.tar.zst" type="application/x-zstd-compressed-tar"/>
    </implementation>
  </group>
</interface>
