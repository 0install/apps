<?xml version="1.0" encoding="utf-8"?>
<interface xmlns="http://zero-install.sourceforge.net/2004/injector/interface">
  <name>File</name>
  <summary>determine file type</summary>
  <description>file tests each argument in an attempt to classify it, using a database of "magic" patterns to recognize file formats.</description>
  <homepage>https://www.darwinsys.com/file/</homepage>
  <icon href="https://apps.0install.net/utils/file.png" type="image/png"/>
  <icon href="https://apps.0install.net/utils/file.ico" type="image/vnd.microsoft.icon"/>
  <category>Utility</category>
  <needs-terminal/>

  <feed-for interface="https://apps.0install.net/utils/file.xml"/>

  <group license="BSD-2-Clause">
    <requires interface="https://apps.0install.net/lib/libsystre.xml">
      <environment insert="bin" name="PATH"/>
    </requires>
    <command name="run" path="bin/file.exe"/>
    <implementation arch="Windows-x86_64" released="{released}" stability="stable" version="{version}">
      <manifest-digest/>
      <archive extract="ucrt64" href="https://repo.msys2.org/mingw/ucrt64/mingw-w64-ucrt-x86_64-file-{pkgver}-{pkgrel}-any.pkg.tar.zst" type="application/x-zstd-compressed-tar"/>
    </implementation>
    <implementation arch="Windows-aarch64" released="{released}" stability="stable" version="{version}">
      <manifest-digest/>
      <archive extract="clangarm64" href="https://repo.msys2.org/mingw/clangarm64/mingw-w64-clang-aarch64-file-{pkgver}-{pkgrel}-any.pkg.tar.zst" type="application/x-zstd-compressed-tar"/>
    </implementation>
  </group>
</interface>
