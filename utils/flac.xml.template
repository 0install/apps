<?xml version="1.0" encoding="utf-8"?>
<interface xmlns="http://zero-install.sourceforge.net/2004/injector/interface">
  <name>FLAC</name>
  <summary>Free Lossless Audio Codec</summary>
  <description>FLAC (Free Lossless Audio Codec) compresses audio without any loss in quality. This package contains the flac encoder/decoder and metaflac for editing metadata.</description>
  <homepage>https://xiph.org/flac/</homepage>
  <category>AudioVideo</category>
  <needs-terminal/>

  <feed-for interface="https://apps.0install.net/utils/flac.xml"/>

  <group license="GPL-2.0-or-later AND BSD-3-Clause">
    <requires interface="https://apps.0install.net/lib/libogg.xml">
      <environment insert="bin" name="PATH"/>
    </requires>
    <requires interface="https://apps.0install.net/lib/libwinpthread.xml">
      <environment insert="bin" name="PATH"/>
    </requires>
    <command name="run" path="bin/flac.exe"/>
    <command name="metaflac" path="bin/metaflac.exe"/>
    <implementation arch="Windows-x86_64" released="{released}" stability="stable" version="{version}">
      <manifest-digest/>
      <archive extract="ucrt64" href="https://repo.msys2.org/mingw/ucrt64/mingw-w64-ucrt-x86_64-flac-{pkgver}-{pkgrel}-any.pkg.tar.zst" type="application/x-zstd-compressed-tar"/>
    </implementation>
    <implementation arch="Windows-aarch64" released="{released}" stability="stable" version="{version}">
      <manifest-digest/>
      <archive extract="clangarm64" href="https://repo.msys2.org/mingw/clangarm64/mingw-w64-clang-aarch64-flac-{pkgver}-{pkgrel}-any.pkg.tar.zst" type="application/x-zstd-compressed-tar"/>
    </implementation>
  </group>
</interface>
