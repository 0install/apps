<?xml version="1.0" encoding="utf-8"?>
<interface xmlns="http://zero-install.sourceforge.net/2004/injector/interface">
  <name>Grep</name>
  <summary>print lines matching a pattern</summary>
  <description>Grep searches one or more input files for lines containing a match to a specified pattern. By default, grep prints the matching lines.</description>
  <homepage>https://www.gnu.org/software/grep/</homepage>
  <icon href="https://apps.0install.net/utils/gnu.png" type="image/png"/>
  <icon href="https://apps.0install.net/utils/gnu.ico" type="image/vnd.microsoft.icon"/>
  <category>Utility</category>
  <needs-terminal/>

  <feed-for interface="https://apps.0install.net/utils/grep.xml"/>

  <group license="GPL-3.0-or-later">
    <requires interface="https://apps.0install.net/devel/libintl.xml">
      <environment insert="bin" name="PATH"/>
    </requires>
    <requires interface="https://apps.0install.net/lib/pcre2.xml">
      <environment insert="bin" name="PATH"/>
    </requires>
    <command name="run" path="bin/grep.exe"/>
    <command name="egrep" path="bin/grep.exe">
      <arg>-E</arg>
    </command>
    <command name="fgrep" path="bin/grep.exe">
      <arg>-F</arg>
    </command>
    <implementation arch="Windows-x86_64" released="{released}" stability="stable" version="{version}">
      <manifest-digest/>
      <archive extract="ucrt64" href="https://repo.msys2.org/mingw/ucrt64/mingw-w64-ucrt-x86_64-grep-{pkgver}-{pkgrel}-any.pkg.tar.zst" type="application/x-zstd-compressed-tar"/>
    </implementation>
    <implementation arch="Windows-aarch64" released="{released}" stability="stable" version="{version}">
      <manifest-digest/>
      <archive extract="clangarm64" href="https://repo.msys2.org/mingw/clangarm64/mingw-w64-clang-aarch64-grep-{pkgver}-{pkgrel}-any.pkg.tar.zst" type="application/x-zstd-compressed-tar"/>
    </implementation>
  </group>
</interface>
