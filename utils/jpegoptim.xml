<?xml version="1.0" ?>
<interface xmlns="http://zero-install.sourceforge.net/2004/injector/interface" uri="https://apps.0install.net/utils/jpegoptim.xml">
  <name>jpegoptim</name>
  <summary>optimize and compress JPEG files</summary>
  <description>jpegoptim losslessly optimizes JPEG files by optimizing their Huffman tables, and can optionally recompress them with a lower maximum quality setting.</description>
  <homepage>https://www.kokkonen.net/tjko/projects.html</homepage>
  <category>Graphics</category>
  <needs-terminal/>

  <package-implementation distributions="Debian RPM Arch" package="jpegoptim" main="/usr/bin/jpegoptim"/>
  <package-implementation distributions="Gentoo" package="media-gfx/jpegoptim" main="/usr/bin/jpegoptim"/>
  <package-implementation distributions="MacPorts" package="jpegoptim" main="/opt/local/bin/jpegoptim"/>

  <entry-point binary-name="jpegoptim" command="run"/>

  <group license="GPL-3.0-or-later">
    <requires interface="https://apps.0install.net/lib/libjpeg-turbo.xml">
      <environment insert="bin" name="PATH"/>
    </requires>
    <command name="run" path="bin/jpegoptim.exe"/>
