<?xml version="1.0" encoding="utf-8"?>
<interface xmlns="http://zero-install.sourceforge.net/2004/injector/interface">
  <name>jpegoptim</name>
  <summary>optimize and compress JPEG files</summary>
  <description>jpegoptim losslessly optimizes JPEG files by optimizing their Huffman tables, and can optionally recompress them with a lower maximum quality setting.</description>
  <homepage>https://www.kokkonen.net/tjko/projects.html</homepage>
  <category>Graphics</category>
  <needs-terminal/>

  <feed-for interface="https://apps.0install.net/utils/jpegoptim.xml"/>

  <group license="GPL-3.0-or-later">
    <requires interface="https://apps.0install.net/lib/libjpeg-turbo.xml">
      <environment insert="bin" name="PATH"/>
    </requires>
    <command name="run" path="bin/jpegoptim.exe"/>
    <implementation arch="Windows-x86_64" released="{released}" stability="stable" version="{version}">
      <manifest-digest/>
      <archive extract="ucrt64" href="https://repo.msys2.org/mingw/ucrt64/mingw-w64-ucrt-x86_64-jpegoptim-{pkgver}-{pkgrel}-any.pkg.tar.zst" type="application/x-zstd-compressed-tar"/>
    </implementation>
    <implementation arch="Windows-aarch64" released="{released}" stability="stable" version="{version}">
      <manifest-digest/>
      <archive extract="clangarm64" href="https://repo.msys2.org/mingw/clangarm64/mingw-w64-clang-aarch64-jpegoptim-{pkgver}-{pkgrel}-any.pkg.tar.zst" type="application/x-zstd-compressed-tar"/>
    </implementation>
  </group>
</interface>
