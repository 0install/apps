<?xml version="1.0" ?>
<interface uri="https://apps.0install.net/utils/lemonade.xml" xmlns="http://zero-install.sourceforge.net/2004/injector/interface">
  <name>Lemonade</name>
  <summary>serve optimized LLMs locally from your own GPUs and NPUs</summary>
  <description>Lemonade helps users discover and run local AI apps by serving optimized LLMs right from their own GPUs and NPUs. It provides an OpenAI-compatible server, a command-line client and (on Windows) a desktop app.</description>
  <homepage>https://lemonade-server.ai/</homepage>
  <category>Utility</category>

  <icon href="https://apps.0install.net/utils/lemonade.png" type="image/png"/>
  <icon href="https://apps.0install.net/utils/lemonade.ico" type="image/vnd.microsoft.icon"/>
  <icon href="https://apps.0install.net/utils/lemonade.icns" type="image/x-icns"/>

  <entry-point binary-name="lemonade" command="run">
    <needs-terminal/>
    <name>Lemonade CLI</name>
    <summary>command-line client for Lemonade Server</summary>
  </entry-point>
  <entry-point binary-name="lemonade-app" command="run-gui">
    <name>Lemonade</name>
    <summary>desktop app for Lemonade Server</summary>
  </entry-point>
  <entry-point binary-name="LemonadeServer" command="server">
    <name>Lemonade Server</name>
    <summary>local LLM server (with system tray icon on Windows)</summary>
  </entry-point>

  <group license="Apache License 2.0">
    <command name="run" path="lemonade"/>
    <command name="server" path="lemond"/>
