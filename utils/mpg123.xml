<?xml version="1.0" ?>
<interface xmlns="http://zero-install.sourceforge.net/2004/injector/interface" uri="https://apps.0install.net/utils/mpg123.xml">
  <name>mpg123</name>
  <summary>fast console MPEG audio player and decoder library</summary>
  <description>mpg123 is a fast and free console-based real-time MPEG audio player and decoder library for layer 1, 2 and 3 (MP3) files.</description>
  <homepage>https://www.mpg123.de/</homepage>
  <category>AudioVideo</category>
  <needs-terminal/>

  <package-implementation distributions="Debian RPM Arch" package="mpg123">
    <command name="run" path="/usr/bin/mpg123"/>
    <command name="out123" path="/usr/bin/out123"/>
    <command name="mpg123-id3dump" path="/usr/bin/mpg123-id3dump"/>
    <command name="mpg123-strip" path="/usr/bin/mpg123-strip"/>
  </package-implementation>
  <package-implementation distributions="Gentoo" package="media-sound/mpg123">
    <command name="run" path="/usr/bin/mpg123"/>
    <command name="out123" path="/usr/bin/out123"/>
    <command name="mpg123-id3dump" path="/usr/bin/mpg123-id3dump"/>
    <command name="mpg123-strip" path="/usr/bin/mpg123-strip"/>
  </package-implementation>
  <package-implementation distributions="MacPorts" package="mpg123">
    <command name="run" path="/opt/local/bin/mpg123"/>
    <command name="out123" path="/opt/local/bin/out123"/>
    <command name="mpg123-id3dump" path="/opt/local/bin/mpg123-id3dump"/>
    <command name="mpg123-strip" path="/opt/local/bin/mpg123-strip"/>
  </package-implementation>

  <entry-point binary-name="mpg123" command="run">
    <needs-terminal/>
    <name>mpg123</name>
    <summary>play MPEG audio files</summary>
  </entry-point>
  <entry-point command="out123">
    <needs-terminal/>
    <name>out123</name>
    <summary>play raw audio data</summary>
  </entry-point>
  <entry-point command="mpg123-id3dump">
    <needs-terminal/>
    <name>mpg123-id3dump</name>
    <summary>dump ID3 tags of MPEG audio files</summary>
  </entry-point>
  <entry-point command="mpg123-strip">
    <needs-terminal/>
    <name>mpg123-strip</name>
    <summary>extract MPEG frames from a stream</summary>
  </entry-point>

  <group license="LGPL-2.1-only">
    <requires interface="https://apps.0install.net/lib/libwinpthread.xml">
      <environment insert="bin" name="PATH"/>
    </requires>
    <command name="run" path="bin/mpg123.exe"/>
    <command name="out123" path="bin/out123.exe"/>
    <command name="mpg123-id3dump" path="bin/mpg123-id3dump.exe"/>
    <command name="mpg123-strip" path="bin/mpg123-strip.exe"/>
