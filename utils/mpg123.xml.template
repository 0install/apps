<?xml version="1.0" encoding="utf-8"?>
<interface xmlns="http://zero-install.sourceforge.net/2004/injector/interface">
  <name>mpg123</name>
  <summary>fast console MPEG audio player and decoder library</summary>
  <description>mpg123 is a fast and free console-based real-time MPEG audio player and decoder library for layer 1, 2 and 3 (MP3) files.</description>
  <homepage>https://www.mpg123.de/</homepage>
  <category>AudioVideo</category>
  <needs-terminal/>

  <feed-for interface="https://apps.0install.net/utils/mpg123.xml"/>

  <group license="LGPL-2.1-only">
    <requires interface="https://apps.0install.net/lib/libwinpthread.xml">
      <environment insert="bin" name="PATH"/>
    </requires>
    <command name="run" path="bin/mpg123.exe"/>
    <command name="out123" path="bin/out123.exe"/>
    <command name="mpg123-id3dump" path="bin/mpg123-id3dump.exe"/>
    <command name="mpg123-strip" path="bin/mpg123-strip.exe"/>
    <implementation arch="Windows-x86_64" released="{released}" stability="stable" version="{version}">
      <manifest-digest/>
      <archive extract="ucrt64" href="https://repo.msys2.org/mingw/ucrt64/mingw-w64-ucrt-x86_64-mpg123-{pkgver}-{pkgrel}-any.pkg.tar.zst" type="application/x-zstd-compressed-tar"/>
    </implementation>
    <implementation arch="Windows-aarch64" released="{released}" stability="stable" version="{version}">
      <manifest-digest/>
      <archive extract="clangarm64" href="https://repo.msys2.org/mingw/clangarm64/mingw-w64-clang-aarch64-mpg123-{pkgver}-{pkgrel}-any.pkg.tar.zst" type="application/x-zstd-compressed-tar"/>
    </implementation>
  </group>
</interface>
