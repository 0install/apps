<?xml version="1.0" encoding="utf-8"?>
<interface xmlns="http://zero-install.sourceforge.net/2004/injector/interface">
  <name>OptiPNG</name>
  <summary>Compresses PNG files to a smaller size, without losing any information</summary>
  <description>OptiPNG optimizes PNG files, i.e. reduces their size to a minimum, without losing semantic information. In addition, it performs a suite of auxiliary functions like integrity checks, metadata recovery and pixmap-to-PNG conversion.</description>
  <homepage>https://optipng.sourceforge.io/</homepage>
  <category>Graphics</category>
  <needs-terminal/>

  <feed-for interface="https://apps.0install.net/utils/optipng.xml"/>

  <group license="Zlib">
    <requires interface="https://apps.0install.net/lib/png16-0.xml">
      <environment insert="bin" name="PATH"/>
    </requires>
    <requires interface="https://apps.0install.net/lib/zlib.xml">
      <environment insert="bin" name="PATH"/>
    </requires>
    <command name="run" path="bin/optipng.exe"/>
    <implementation arch="Windows-x86_64" released="{released}" stability="stable" version="{version}">
      <manifest-digest/>
      <archive extract="ucrt64" href="https://repo.msys2.org/mingw/ucrt64/mingw-w64-ucrt-x86_64-optipng-{pkgver}-{pkgrel}-any.pkg.tar.zst" type="application/x-zstd-compressed-tar"/>
    </implementation>
    <implementation arch="Windows-aarch64" released="{released}" stability="stable" version="{version}">
      <manifest-digest/>
      <archive extract="clangarm64" href="https://repo.msys2.org/mingw/clangarm64/mingw-w64-clang-aarch64-optipng-{pkgver}-{pkgrel}-any.pkg.tar.zst" type="application/x-zstd-compressed-tar"/>
    </implementation>
  </group>
</interface>
