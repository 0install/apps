<?xml version="1.0" ?>
<interface xmlns="http://zero-install.sourceforge.net/2004/injector/interface" uri="https://apps.0install.net/utils/x265.xml">
  <name>x265</name>
  <summary>H.265/HEVC video encoder</summary>
  <description>x265 is an open-source encoder for the H.265/High Efficiency Video Coding (HEVC) video compression standard.</description>
  <homepage>https://www.x265.org/</homepage>
  <category>AudioVideo</category>
  <needs-terminal/>

  <package-implementation distributions="Debian RPM Arch" package="x265" main="/usr/bin/x265"/>
  <package-implementation distributions="Gentoo" package="media-libs/x265" main="/usr/bin/x265"/>
  <package-implementation distributions="MacPorts" package="x265" main="/opt/local/bin/x265"/>

  <entry-point binary-name="x265" command="run"/>

  <group license="GPL-2.0-or-later">
