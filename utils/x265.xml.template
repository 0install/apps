<?xml version="1.0" encoding="utf-8"?>
<interface xmlns="http://zero-install.sourceforge.net/2004/injector/interface">
  <name>x265</name>
  <summary>H.265/HEVC video encoder</summary>
  <description>x265 is an open-source encoder for the H.265/High Efficiency Video Coding (HEVC) video compression standard.</description>
  <homepage>https://www.x265.org/</homepage>
  <category>AudioVideo</category>
  <needs-terminal/>

  <feed-for interface="https://apps.0install.net/utils/x265.xml"/>

  <group license="GPL-2.0-or-later">
    <requires interface="https://apps.0install.net/lib/cc-libs.xml">
      <environment insert="bin" name="PATH"/>
    </requires>
    <command name="run" path="bin/x265.exe"/>
    <implementation arch="Windows-x86_64" released="{released}" stability="stable" version="{version}">
      <manifest-digest/>
      <archive extract="ucrt64" href="https://repo.msys2.org/mingw/ucrt64/mingw-w64-ucrt-x86_64-x265-{pkgver}-{pkgrel}-any.pkg.tar.zst" type="application/x-zstd-compressed-tar"/>
    </implementation>
    <implementation arch="Windows-aarch64" released="{released}" stability="stable" version="{version}">
      <manifest-digest/>
      <archive extract="clangarm64" href="https://repo.msys2.org/mingw/clangarm64/mingw-w64-clang-aarch64-x265-{pkgver}-{pkgrel}-any.pkg.tar.zst" type="application/x-zstd-compressed-tar"/>
    </implementation>
  </group>
</interface>
