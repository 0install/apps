<?xml version="1.0" encoding="utf-8"?>
<interface xmlns="http://zero-install.sourceforge.net/2004/injector/interface">
  <name>Zopfli</name>
  <summary>very good, but slow, deflate and PNG compression</summary>
  <description>Zopfli is a compression library that produces deflate-compatible output (gzip, zlib, PNG) a few percent smaller than other compressors, at the cost of much slower compression. This package contains the zopfli command-line compressor and zopflipng, a PNG optimizer.</description>
  <homepage>https://github.com/google/zopfli</homepage>
  <category>Utility</category>
  <needs-terminal/>

  <feed-for interface="https://apps.0install.net/utils/zopfli.xml"/>

  <group license="Apache-2.0">
    <requires interface="https://apps.0install.net/lib/cc-libs.xml">
      <environment insert="bin" name="PATH"/>
    </requires>
    <command name="run" path="bin/zopfli.exe"/>
    <command name="zopflipng" path="bin/zopflipng.exe"/>
    <implementation arch="Windows-x86_64" released="{released}" stability="stable" version="{version}">
      <manifest-digest/>
      <archive extract="ucrt64" href="https://repo.msys2.org/mingw/ucrt64/mingw-w64-ucrt-x86_64-zopfli-{pkgver}-{pkgrel}-any.pkg.tar.zst" type="application/x-zstd-compressed-tar"/>
    </implementation>
    <implementation arch="Windows-aarch64" released="{released}" stability="stable" version="{version}">
      <manifest-digest/>
      <archive extract="clangarm64" href="https://repo.msys2.org/mingw/clangarm64/mingw-w64-clang-aarch64-zopfli-{pkgver}-{pkgrel}-any.pkg.tar.zst" type="application/x-zstd-compressed-tar"/>
    </implementation>
  </group>
</interface>
